# Déjala vacía para usar el proxy de Vite (recomendado en desarrollo):
#   /api/auth y /api/usuarios  -> usuarios (http://localhost:8082)
#   /api/tienda y /api/inventario -> tienda (http://localhost:8083)
VITE_API_URL=
# Tiempo máximo de espera de la API en milisegundos (fallback local si expira).
VITE_API_TIMEOUT=4000
